# Backend environment variables
# Copy this file to `.env` and update the values for local development

# Database connection
DATABASE_URL=postgresql://USER:PASS@localhost:5432/tipjar

# Server configuration
BACKEND_PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_DOMAIN_FOR_SIWE=localhost
FRONTEND_LOGIN_FAILURE_REDIRECT_URL=/login?error=oauth_failed
FRONTEND_LOGIN_SUCCESS_REDIRECT_URL=/dashboard

# JWT configuration
JWT_ACCESS_TOKEN_SECRET=change_me_access_secret
JWT_REFRESH_TOKEN_SECRET=change_me_refresh_secret
JWT_ACCESS_TOKEN_EXPIRATION_TIME=15m
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# Mailer configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=example@example.com
MAIL_PASS=password
MAIL_FROM_NAME=TipJar
MAIL_FROM_ADDRESS=noreply@tipjar.example.com

# Redis connection
REDIS_URL=redis://localhost:6379

# Circle API
CIRCLE_API_KEY=your_circle_api_key
CIRCLE_ENTITY_SECRET=your_circle_entity_secret
CIRCLE_WALLET_SET_ID=wallet-set-id
DEFAULT_BLOCKCHAIN=ARC-TESTNET
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_CHAIN_ID=5042002
ARC_CCTP_DOMAIN=26
ARC_USDC_CONTRACT=0x3600000000000000000000000000000000000000
USDC_TOKEN_ID=0x3600000000000000000000000000000000000000
# Chain-specific USDC token IDs (UUIDs from Circle — required for non-Arc chains)
USDC_TOKEN_ID_ARC=0x3600000000000000000000000000000000000000
USDC_TOKEN_ID_BASE_SEPOLIA=
USDC_TOKEN_ID_ARB_SEPOLIA=
USDC_TOKEN_ID_POLYGON_AMOY=
USDC_TOKEN_ID_BNB_TESTNET=
USDC_TOKEN_ID_BASE=
USDC_TOKEN_ID_ARB=
USDC_TOKEN_ID_POLYGON=
USDC_TOKEN_ID_BNB=
ARC_GAS_STATION_CONTRACT=0x7ceA357B5AC039F8F9e378a1f03Aa5005C0a25
ARC_GATEWAY_CONTRACT=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
ARC_PAYMASTER_CONTRACT=0x31BE08D380A21fc740883c0BC434FcFc88740b58
GATEWAY_DELEGATE_WALLET_ADDRESS=
FEE_WALLET_ADDRESS=0x40d497fccda3e99c469084a3741d662454245855
FEE_WALLET_ID=729afc4f-8b1c-5e25-bed9-b47f8bf766ab

# Generator API
GEMINI_API_KEY=your_gemini_api_key

# OAuth providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_CALLBACK_URL=http://localhost:3001/api/v1/auth/twitch/callback

# Misc
ALLOW_RESEND_VERIFICATION_FOR_VERIFIED=false
