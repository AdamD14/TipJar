{
  "workbench.editor.alwaysShowEditorActions": true,
  "workbench.editor.autoLockGroups": {
    "default": true,
    "workbench.editorinputs.searchEditorInput": true,
    "notebookOutputEditor": true,
    "workbench.editors.gettingStartedInput": true,
    "gitlens.rebase": true,
    "antigravity.workflowEditor": true
  },
  
  // Konfiguracja Deno - zapobiega konfliktom z Node.js
  "deno.enable": true,
  "deno.enablePaths": [
    "supabase/functions"
  ],
  "deno.importMap": "supabase/functions/storj-presigned/deno.json",
  "deno.suggest.imports.hosts": {
    "https://deno.land": true,
    "https://esm.sh": true
  }
}